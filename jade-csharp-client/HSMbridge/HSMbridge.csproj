<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HSMbridge</RootNamespace>
    <AssemblyName>HSMbridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to JadeClient library -->
