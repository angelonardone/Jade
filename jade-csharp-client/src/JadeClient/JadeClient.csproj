<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JadeClient</RootNamespace>
    <AssemblyName>JadeClient</AssemblyName>

    <!-- NuGet Package Info -->
    <PackageId>JadeClient</PackageId>
    <Version>0.1.0</Version>
    <Authors>Your Name</Authors>
    <Company>Your Company</Company>
    <Description>C# client library for Blockstream Jade hardware wallet</Description>
    <PackageTags>bitcoin;hardware-wallet;jade;blockstream;cryptocurrency</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Blockstream/Jade</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- CBOR serialization -->
    <PackageReference Include="PeterO.Cbor" Version="4.5.2" />

    <!-- Serial port communication - explicitly include all runtimes for cross-platform publishing -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- Ensure runtime-specific native libraries are included when publishing -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <_EnableSingleFileAnalyzer>false</_EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- Include native libraries in single-file publish -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.IO.Ports.Legacy" Value="false" />
  </ItemGroup>

</Project>
