<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GxJadeLib</RootNamespace>
    <AssemblyName>GxJadeLib</AssemblyName>

    <!-- NuGet Package Info -->
    <PackageId>GxJadeLib</PackageId>
    <Version>0.1.0</Version>
    <Authors>Your Name</Authors>
    <Company>Your Company</Company>
    <Description>GeneXus External Object wrapper for Blockstream Jade hardware wallet</Description>
    <PackageTags>bitcoin;hardware-wallet;jade;blockstream;genexus;external-object</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JadeClient\JadeClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct dependencies for GeneXus - ensures DLLs are copied to output -->
    <PackageReference Include="PeterO.Cbor" Version="4.5.2" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>
